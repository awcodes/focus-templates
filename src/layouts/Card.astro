---
import '../styles/card.css';

interface Props {
    title: string;
    width?: number;
    height?: number;
}

const { title, width = 2560, height = 1440 } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex, nofollow" />
        <!-- Focus lays the page out at this size and scales it to each card size. -->
        <meta name="focus:canvas" content={`${width}x${height}`} />
        <title>{title} | aw.codes</title>
    </head>
    <body class="m-0 bg-gray-950 font-sans text-white antialiased">
        <div class="relative overflow-hidden" style={{ width: `${width}px`, height: `${height}px` }}>
            <div class="relative z-0">
                <img alt="" src="/background.jpg" width={width} height={height} class="object-cover object-center opacity-75" style={{ width: `${width}px`, height: `${height}px` }} />
            </div>
            <slot />
        </div>
    </body>
</html>
