---
import LogoVertical from '../components/LogoVertical.astro';
import Card from '../layouts/Card.astro';
---

<Card title="Default Wide" width={2400} height={1260}>
    <div class="absolute inset-0 grid place-content-center p-[70px]">
        <div class="flex justify-center">
            <div class="h-75 w-auto">
                <LogoVertical class="h-full w-auto" />
            </div>
        </div>

        <div data-focus="title" class="mt-24 w-full max-w-400 text-center text-9xl leading-none font-bold text-shadow">
            Project Title
        </div>

        <div data-focus="description" class="mt-8 w-full max-w-400 text-center text-5xl leading-[1.3] text-shadow">
            Description: Proident veniam nostrud culpa culpa ex ex deserunt in veniam duis consectetur cillum.
        </div>

        <div data-focus="install" class="mx-auto mt-20 w-fit rounded-xl bg-gray-950/70 px-10 py-6 text-center font-mono text-4xl text-shadow">
            composer require awcodes/preview
        </div>
    </div>
</Card>
