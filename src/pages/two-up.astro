---
import LogoVertical from '../components/LogoVertical.astro';
import Card from '../layouts/Card.astro';
---

<Card title="Two Up">
    <div data-focus="title" class="absolute top-17.5 left-17.5 text-[10rem] leading-none font-bold text-shadow">
        Project Title
    </div>

    <!-- The description ends 70px before the light screenshot, which starts 1500px from the right edge. -->
    <div data-focus="description" class="absolute top-70 left-17.5 max-w-212.5 text-5xl leading-[1.3] text-shadow">
        Description: Proident veniam nostrud culpa culpa ex ex deserunt in veniam duis consectetur cillum.
    </div>

    <div class="screenshot absolute top-117.5 right-17.5 aspect-1400/816 w-375 overflow-hidden rounded-3xl border border-gray-900/20 shadow-2xl">
        <img data-focus="screenshot.2.light" alt="" src="/samples/secondary.png" width="1400" height="816" class="h-full w-full object-cover object-top-left" />
    </div>

    <div class="screenshot absolute bottom-17.5 left-17.5 z-10 aspect-1400/816 w-287.5 overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
        <img data-focus="screenshot.1.dark" alt="" src="/samples/primary.png" width="1400" height="816" class="h-full w-full object-cover object-top-left" />
    </div>

    <div class="absolute top-17.5 right-17.5 h-40 w-auto">
        <LogoVertical class="h-full w-auto" />
    </div>
</Card>
